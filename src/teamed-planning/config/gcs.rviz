Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /MarkerArray1
        - /Odometry1
        - /Odometry2
        - /Odometry3
        - /Odometry4
        - /PointCloud21
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /visualization_markers
      Name: GCS Visualization
      Namespaces:
        drone_graphs: true
        goal: true
        ground_graph: true
        labels: true
        robots: true
      Queue Size: 10
      Value: true

    # Drone odom trails removed: MAVROS publishes all iris_N odom with
    # frame_id="map" (shared origin), so all trails overlap at (0,0,0).
    # Drone positions are visualised correctly via the GCS MarkerArray spheres
    # which apply the spawn_offset to convert MAVROS-local → map frame.
    #
    # Ground robot path kept below — its odom is in ground_0/odom frame
    # which is correctly connected to map via static TF.

    - Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.01
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.5
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: false
      Enabled: true
      Keep: 200
      Name: Ground robot path
      Position Tolerance: 0.1
      Queue Size: 10
      Shape:
        Alpha: 1
        Arrow Length: 0.5
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 85; 0
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.35
        Shaft Radius: 0.02
        Value: Arrow
      Topic: /ground_0/odom
      Unreliable: false
      Value: true
      Angle Tolerance: 0.1

    # Planned path: the route the ground robot intends to drive.
    # Published by ground_node.py → /ground_0/planned_path (nav_msgs/Path, map frame).
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 255; 50; 50
      Enabled: true
      Head Diameter: 0.4
      Head Length: 0.3
      Length: 0.5
      Line Style: Billboards
      Line Width: 0.25
      Name: Ground planned path
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 255; 100; 100
      Pose Style: Axes
      Queue Size: 10
      Radius: 0.08
      Shaft Diameter: 0.15
      Shaft Length: 0.3
      Topic: /ground_0/planned_path
      Unreliable: false
      Value: true

    - Class: rviz/PointCloud2
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 200; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Ground LiDAR
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic: /ground_0/velodyne_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    - Alpha: 1
      Arrow Length: 0.3
      Arrow Width: 0.1
      Class: rviz/PoseArray
      Color: 255; 0; 0
      Enabled: false
      Head Length: 0.07
      Head Radius: 0.03
      Name: Drone 0 setpoint
      Queue Size: 10
      Shaft Length: 0.23
      Shaft Radius: 0.01
      Shape: Arrow (Flat)
      Topic: /iris_0/mavros/setpoint_position/local
      Unreliable: false
      Value: false

    # ── Occupancy grids (projection verification) ────────────────────────────
    # Compare red cells with actual tree positions in Gazebo to verify:
    #   - footprint SIZE (should match 2*alt*tan(HFOV/2) rectangle)
    #   - AXIS ORIENTATION (red = obstacle; if rotated 90° vs reality, rows/cols are swapped)
    - Class: rviz/Map
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Drone 0 OccGrid (projection debug)
      Topic: /drone_0/occ_grid
      Unreliable: false
      Use Timestamp: false
      Value: true

    - Class: rviz/Map
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Drone 1 OccGrid (projection debug)
      Topic: /drone_1/occ_grid
      Unreliable: false
      Use Timestamp: false
      Value: true

    - Class: rviz/Map
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Drone 2 OccGrid (projection debug)
      Topic: /drone_2/occ_grid
      Unreliable: false
      Use Timestamp: false
      Value: true

    # ── Segmentation images (sim only — requires SegFormer model downloaded) ──
    - Class: rviz/Image
      Enabled: true
      Image Topic: /drone_0/seg_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Drone 0 Segmentation
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    - Class: rviz/Image
      Enabled: true
      Image Topic: /drone_1/seg_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Drone 1 Segmentation
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

    - Class: rviz/Image
      Enabled: true
      Image Topic: /drone_2/seg_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Drone 2 Segmentation
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive: false
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1280
  X: 0
  Y: 0
