diff -ruN a/src/teamed-planning/scripts/drone/relay_attention_mappo.py b/src/teamed-planning/scripts/drone/relay_attention_mappo.py
--- a/src/teamed-planning/scripts/drone/relay_attention_mappo.py	1970-01-01 08:00:00.000000000 +0800
+++ b/src/teamed-planning/scripts/drone/relay_attention_mappo.py	2026-10-28 12:56:23.351218477 +0800
@@ -0,0 +1,174 @@
+"""v8: v7 cooperative policy plus age/hop-aware attention over relayed state evidence.
+
+Tokens are this device's own relay cache (drone/relay_cache.py): teammates and
+the vehicle, directly sensed or not, with the ORIGINAL measurement age and the
+hop count of the path that delivered them. Relative relevance is a masked
+softmax whose logits subtract learned, type-specific age and hop penalties.
+An absolute reliability gate rho = exp(-age/tau - lambda_h (h-1) - lambda_s sigma^2)
+then scales the weights WITHOUT renormalising, so "everything is stale" shrinks
+the context instead of remaining a convex combination. Count/reliability
+summaries are exposed explicitly; an empty cache gives a zero context.
+
+One-hop geometry, the RNG backbone and the CBF are exactly v7's. Device IDs
+only match tokens to currently sensed peers; they are never embedded.
+"""
+import numpy as np
+import torch
+from torch import nn
+from drone.cooperative_mappo import (CooperativeActorCritic, CooperativeCriticEncoder, CooperativeEncoder,
+    RAW_WIDTH as COOPERATIVE_WIDTH, ENCODED_WIDTH as COOPERATIVE_ENCODED)
+from drone.graph_attention_mappo import GraphAttentionActorCritic, MAX_FLEET, prefix_width
+
+RELAY_TOKENS = MAX_FLEET
+# Token layout: 0-2 relative source position, 3-5 source velocity and known flag,
+# 6 age (s), 7 hop count, 8-9 type (drone/vehicle), 10 sigma/95 m, 11 source time
+# unknown, 12 origin currently sensed one hop, 13-15 relative task goal and flag.
+RELAY_FEATURES = 16
+AGE, HOP, VEHICLE, SIGMA = 6, 7, 9, 10
+CONTENT = [i for i in range(RELAY_FEATURES) if i not in (AGE, HOP)]
+RAW_WIDTH = COOPERATIVE_WIDTH+RELAY_TOKENS*(RELAY_FEATURES+1)
+TIME_FEATURES = 8
+HEADS, HEAD_WIDTH = 2, 16
+RELAY_STATS = 4
+ENCODED_WIDTH = COOPERATIVE_ENCODED+HEADS*HEAD_WIDTH+RELAY_STATS
+# Ablations of the v8 validation matrix: full = v8-D, age = v8-A, hop = v8-B,
+# softmax = v8-C (age+hop in the logits, no absolute gate).
+MODES = ('full', 'age', 'hop', 'softmax')
+# Fixed gate parameters (design values, not validated on aircraft).
+TAU_S = (10., 30.)  # drone_state, vehicle_state
+HOP_DECAY = .1
+SIGMA_DECAY = 1.    # per (sigma/95 m)^2
+
+
+class TimeEncoding(nn.Module):
+    """TGAT-style functional time encoding cos(w*dt + b), learnable w and b."""
+    def __init__(self, width=TIME_FEATURES):
+        super().__init__()
+        self.frequency = nn.Parameter(torch.from_numpy(1./np.geomspace(1., 100., width)).float())
+        self.phase = nn.Parameter(torch.zeros(width))
+
+    def forward(self, age):
+        return torch.cos(age.unsqueeze(-1)*self.frequency+self.phase)
+
+
+class RelayAttention(nn.Module):
+    def __init__(self, query_width, mode='full'):
+        super().__init__()
+        self.register_buffer('mode', torch.tensor(MODES.index(mode)))
+        self.register_buffer('tau', torch.tensor(TAU_S))
+        self.time = TimeEncoding()
+        width = len(CONTENT)+TIME_FEATURES+1
+        self.query = nn.Linear(query_width, HEADS*HEAD_WIDTH)
+        # Separate key/value projections per payload type.
+        self.key = nn.ModuleList(nn.Linear(width, HEADS*HEAD_WIDTH) for _ in range(2))
+        self.value = nn.ModuleList(nn.Linear(width, HEADS*HEAD_WIDTH) for _ in range(2))
+        start = float(np.log(np.expm1(.5)))  # softplus(start) = 0.5
+        self.age_penalty = nn.Parameter(torch.full((2, HEADS), start))
+        self.hop_penalty = nn.Parameter(torch.full((2, HEADS), start))
+
+    def forward(self, query, tokens, valid):
+        mode = MODES[int(self.mode)]
+        use_age, use_hop, gate = mode != 'hop', mode != 'age', mode != 'softmax'
+        age, hop = tokens[..., AGE], tokens[..., HOP]
+        vehicle = tokens[..., VEHICLE] > .5
+        kind = vehicle.long()
+        log_hop = torch.log1p(hop.clamp_min(0.))
+        time = self.time(age)
+        z = torch.cat((tokens[..., CONTENT], time if use_age else torch.zeros_like(time),
+                       (log_hop if use_hop else torch.zeros_like(log_hop)).unsqueeze(-1)), -1)
+        shape = (*tokens.shape[:-1], HEADS, HEAD_WIDTH)
+        key = torch.where(vehicle[..., None], self.key[1](z), self.key[0](z)).reshape(shape)
+        value = torch.where(vehicle[..., None], self.value[1](z), self.value[0](z)).reshape(shape)
+        q = self.query(query).reshape(*query.shape[:-1], 1, HEADS, HEAD_WIDTH)
+        logits = (q*key).sum(-1)/np.sqrt(HEAD_WIDTH)
+        tau = torch.where(vehicle, self.tau[1], self.tau[0])
+        if use_age:
+            logits = logits-nn.functional.softplus(self.age_penalty)[kind]*(age/tau)[..., None]
+        if use_hop:
+            logits = logits-nn.functional.softplus(self.hop_penalty)[kind]*log_hop[..., None]
+        # Hard mask first (absent/expired entries never reach the cache encoding).
+        weights = logits.masked_fill(~valid[..., None], -1e9).softmax(-2)*valid[..., None]
+        rho = valid.float()
+        if gate:
+            exponent = SIGMA_DECAY*tokens[..., SIGMA].square()
+            if use_age:
+                exponent = exponent+age/tau
+            if use_hop:
+                exponent = exponent+HOP_DECAY*(hop-1.).clamp_min(0.)
+            rho = rho*torch.exp(-exponent)
+        context = ((weights*rho[..., None]).unsqueeze(-1)*value).sum(-3).reshape(*query.shape[:-1], -1)
+        count = valid.float().sum(-1, keepdim=True)
+        stats = torch.cat((torch.log1p(count)/np.log(RELAY_TOKENS+1.),
+                           rho.sum(-1, keepdim=True)/count.clamp_min(1.),
+                           rho.amax(-1, keepdim=True), (count == 0).float()), -1)
+        return context, stats
+
+
+class RelayEncoder(CooperativeEncoder):
+    def __init__(self, mode='full'):
+        super().__init__()
+        self.relay = RelayAttention(prefix_width(2)+64, mode)
+
+    def forward(self, x):
+        cooperative = super().forward(x[..., :COOPERATIVE_WIDTH])
+        tokens = x[..., COOPERATIVE_WIDTH:COOPERATIVE_WIDTH+RELAY_TOKENS*RELAY_FEATURES].reshape(
+            *x.shape[:-1], RELAY_TOKENS, RELAY_FEATURES)
+        valid = x[..., -RELAY_TOKENS:] > 0
+        # Same query as the v7 peer branch: own state/sensor/map encoding.
+        context, stats = self.relay(cooperative[..., :prefix_width(2)+64], tokens, valid)
+        return torch.cat((cooperative, context, stats), -1)
+
+
+class RelayActorCritic(CooperativeActorCritic):
+    policy_architecture = 'gat_relay_attention_v8'
+
+    def __init__(self, global_features=10, input_version=2, relay_attention='full'):
+        if input_version != 2:
+            raise ValueError('v8 requires actor_input_version=2')
+        if relay_attention not in MODES:
+            raise ValueError(f'relay_attention must be one of {MODES}')
+        GraphAttentionActorCritic.__init__(self, global_features, input_version)
+        self.feature_version = 8
+        self.relay_attention = relay_attention
+        self.gat_actor = nn.Sequential(RelayEncoder(relay_attention), nn.Linear(ENCODED_WIDTH, 128), nn.Tanh(),
+            nn.Linear(128, 128), nn.Tanh(), nn.Linear(128, 2))
+        self.critic = nn.Sequential(
+            CooperativeCriticEncoder(global_features, RelayEncoder(relay_attention), RAW_WIDTH, ENCODED_WIDTH),
+            nn.Linear(ENCODED_WIDTH+global_features, 128), nn.Tanh(),
+            nn.Linear(128, 64), nn.Tanh(), nn.Linear(64, 1))
+        nn.init.orthogonal_(self.gat_actor[-1].weight, gain=.01)
+        nn.init.zeros_(self.gat_actor[-1].bias)
+
+    @classmethod
+    def from_state_dict(cls, state):
+        mode = MODES[int(state['gat_actor.0.relay.mode'])]
+        model = cls(state['critic.1.weight'].shape[1]-ENCODED_WIDTH, 2, mode)
+        model.load_state_dict(state)
+        return model
+
+    def encode_graph(self, base, position, observation):
+        cooperative = super().encode_graph(base, position, observation)
+        tokens = np.zeros((RELAY_TOKENS, RELAY_FEATURES), np.float32)
+        valid = np.zeros(RELAY_TOKENS, np.float32)
+        p = np.zeros(3)
+        p[:len(position)] = position
+        data = observation.get('cooperation', {})
+        sensed = set(data.get('peers', {}))
+        # KeyError on purpose: v8 never silently acts without its relay cache.
+        # The cache lists vehicle/task records first, then fresher and shorter
+        # paths, so truncation never drops the only task record for distance.
+        for i, row in enumerate(observation['relay'][:RELAY_TOKENS]):
+            vehicle = row['payload_type'] == 'vehicle_state'
+            q = np.zeros(3)
+            q[:len(row['position'])] = row['position']
+            delta = q-p
+            velocity, goal = row['velocity'], row['goal']
+            tokens[i] = [delta[0]/350., delta[1]/350., delta[2]/15.,
+                         *((velocity[0]/6., velocity[1]/6.) if velocity is not None else (0., 0.)),
+                         float(velocity is not None), row['age'], row['hop'],
+                         float(not vehicle), float(vehicle), row['sigma']/95., float(row['time_unknown']),
+                         float(data.get('ground') is not None) if vehicle else float(row['origin_id'] in sensed),
+                         *(((goal[0]-p[0])/350., (goal[1]-p[1])/350.) if goal is not None else (0., 0.)),
+                         float(goal is not None)]
+            valid[i] = 1.
+        return np.r_[cooperative, tokens.ravel(), valid].astype(np.float32)
diff -ruN a/src/teamed-planning/scripts/drone/relay_cache.py b/src/teamed-planning/scripts/drone/relay_cache.py
--- a/src/teamed-planning/scripts/drone/relay_cache.py	1970-01-01 08:00:00.000000000 +0800
+++ b/src/teamed-planning/scripts/drone/relay_cache.py	2026-10-28 12:56:23.351218477 +0800
@@ -0,0 +1,201 @@
+"""v8 per-device relay cache for state evidence (deployable logic, no transport).
+
+Every entry keeps its ORIGINAL measurement time and sequence number across
+hops; forwarding only increments hop_count and replaces sender_id. Each
+(origin, boot, seq) counts once, an older sequence never replaces a newer one,
+and a restarted origin (new boot_id) is accepted only with a newer source time.
+expires_at is set once by the origin and never refreshed by a relay.
+
+The receiver decides what is usable at decision time: an entry exists only
+after an actual envelope delivered it; unknown remote devices have no entry.
+Transport (radio, ROS topics, simulator links) is the caller's job.
+"""
+import numpy as np
+
+FRAME_ID = 'world'
+TYPES = ('drone_state', 'vehicle_state')
+# Design parameters (not validated on hardware): validity window per payload
+# type, origin measurement sigma (m), and the default hop limit.
+TTL_S = {'drone_state': 30., 'vehicle_state': 60.}
+SIGMA_M = .5
+HOP_LIMIT = 16
+
+
+def make_entry(origin_id, boot_id, seq, source_stamp, payload_type, position, velocity=None,
+               goal=None, sigma=SIGMA_M, mission_id=None, goal_epoch=0, hop_limit=HOP_LIMIT,
+               ttl=None):
+    """Origin-side record; hop_count 0 means 'still at its origin'."""
+    if payload_type not in TYPES:
+        raise ValueError(f'Unknown relay payload type {payload_type}')
+    ttl = TTL_S[payload_type] if ttl is None else ttl
+    return dict(origin_id=str(origin_id), boot_id=int(boot_id), seq=int(seq),
+                source_stamp=None if source_stamp is None else float(source_stamp),
+                sender_id=str(origin_id), receive_stamp=None, hop_count=0,
+                payload_type=payload_type, frame_id=FRAME_ID,
+                state=dict(position=tuple(float(v) for v in position),
+                           velocity=None if velocity is None else tuple(float(v) for v in velocity),
+                           goal=None if goal is None else tuple(float(v) for v in goal)),
+                sigma=float(sigma), mission_id=mission_id, goal_epoch=int(goal_epoch),
+                hop_limit=int(hop_limit),
+                expires_at=None if source_stamp is None or ttl is None else float(source_stamp)+ttl)
+
+
+def _copy(entry):
+    return dict(entry, state=dict(entry['state']))
+
+
+class RelayManager:
+    """Knowledge cache G_info,i of one device: dedupe, ordering, TTL, forwarding."""
+
+    def __init__(self, device_id, boot_id=0, capacity=16, max_entries=64, mission_id=None,
+                 future_tolerance=.5, clock_offset=None, clock_bound=0., per_hop_delay_bound=2.,
+                 speed_bound=6., ttl=None):
+        self.device_id = str(device_id)
+        self.boot_id = int(boot_id)
+        self.capacity = int(capacity)
+        self.max_entries = int(max_entries)
+        self.mission_id = mission_id
+        self.future_tolerance = float(future_tolerance)
+        # Estimated clock offset per origin (s, origin clock minus local clock) and its bound.
+        self.clock_offset = dict(clock_offset or {})
+        self.clock_bound = float(clock_bound)
+        self.per_hop_delay_bound = float(per_hop_delay_bound)
+        self.speed_bound = float(speed_bound)
+        self.ttl = dict(TTL_S, **(ttl or {}))
+        self.seq = -1
+        self.own = None
+        self.cache = {}
+        self.goal_epochs = {}
+        self._sent = set()
+        self.stats = dict.fromkeys(('received', 'accepted', 'duplicate', 'better_path', 'stale',
+                                    'future', 'expired', 'rejected_frame', 'rejected_mission',
+                                    'rejected_epoch', 'hop_limit', 'evicted'), 0)
+
+    # ----- origin side -------------------------------------------------
+    def originate(self, now, payload_type, position, velocity=None, goal=None, sigma=SIGMA_M,
+                  goal_epoch=0):
+        self.seq += 1
+        self.own = make_entry(self.device_id, self.boot_id, self.seq, now, payload_type,
+                              position, velocity, goal, sigma, self.mission_id, goal_epoch,
+                              ttl=self.ttl[payload_type])
+        return self.own
+
+    # ----- receiver side -----------------------------------------------
+    def age(self, entry, now):
+        """Conservative age (s) and whether the source time was unknown."""
+        if entry['source_stamp'] is None:
+            return max(now-entry['receive_stamp'], 0.)+entry['hop_count']*self.per_hop_delay_bound, True
+        offset = self.clock_offset.get(entry['origin_id'], 0.)
+        return max(now-(entry['source_stamp']-offset), 0.), False
+
+    def expired(self, entry, now):
+        if entry['expires_at'] is not None:
+            # expires_at is on the origin clock (offset = origin minus local).
+            return now+self.clock_offset.get(entry['origin_id'], 0.) > entry['expires_at']+1e-9
+        return self.age(entry, now)[0] > self.ttl[entry['payload_type']]
+
+    def _newer(self, incoming, stored):
+        if incoming['boot_id'] == stored['boot_id']:
+            return incoming['seq'] > stored['seq']
+        # A restart resets seq; only a provably newer measurement replaces it.
+        if incoming['source_stamp'] is None or stored['source_stamp'] is None:
+            return False
+        return incoming['source_stamp'] > stored['source_stamp']
+
+    def receive(self, envelope, now):
+        """Accept one delivered envelope (a list of wire entries) at local time now."""
+        for wire in envelope or ():
+            self.stats['received'] += 1
+            entry = _copy(wire)
+            entry['hop_count'] = int(wire['hop_count'])+1
+            entry['receive_stamp'] = float(now)
+            origin = entry['origin_id']
+            if origin == self.device_id:
+                continue  # Own state is authoritative; echoes are ignored.
+            if entry['frame_id'] != FRAME_ID or entry['payload_type'] not in TYPES:
+                self.stats['rejected_frame'] += 1
+                continue
+            if self.mission_id is not None and entry['mission_id'] not in (None, self.mission_id):
+                self.stats['rejected_mission'] += 1
+                continue
+            if entry['hop_count'] > entry['hop_limit']:
+                self.stats['hop_limit'] += 1
+                continue
+            if entry['source_stamp'] is not None:
+                skew = entry['source_stamp']-self.clock_offset.get(origin, 0.)-now
+                if skew > self.future_tolerance:
+                    # Quarantined, never truncated into the freshest message.
+                    self.stats['future'] += 1
+                    continue
+            if self.expired(entry, now):
+                self.stats['expired'] += 1
+                continue
+            if entry['payload_type'] == 'vehicle_state':
+                if entry['goal_epoch'] < self.goal_epochs.get(origin, -1):
+                    self.stats['rejected_epoch'] += 1
+                    continue
+                self.goal_epochs[origin] = entry['goal_epoch']
+            stored = self.cache.get(origin)
+            if stored is not None and (stored['boot_id'], stored['seq']) == (entry['boot_id'], entry['seq']):
+                # Same measurement via another path: one piece of evidence. Keep
+                # the shorter path's transport metadata, never a new source time.
+                self.stats['duplicate'] += 1
+                if entry['hop_count'] < stored['hop_count']:
+                    stored.update(hop_count=entry['hop_count'], sender_id=entry['sender_id'])
+                    self.stats['better_path'] += 1
+                continue
+            if stored is not None and not self._newer(entry, stored):
+                self.stats['stale'] += 1
+                continue
+            self.cache[origin] = entry
+            self.stats['accepted'] += 1
+        self.prune(now)
+
+    def prune(self, now):
+        for origin in [o for o, e in self.cache.items() if self.expired(e, now)]:
+            del self.cache[origin]
+        if len(self.cache) > self.max_entries:
+            # Oldest first; one vehicle (task) record per origin is kept longest.
+            order = sorted(self.cache, key=lambda o: (self.cache[o]['payload_type'] == 'vehicle_state',
+                                                       -self.age(self.cache[o], now)[0], o))
+            for origin in order[:len(self.cache)-self.max_entries]:
+                del self.cache[origin]
+                self.stats['evicted'] += 1
+
+    # ----- forwarding --------------------------------------------------
+    def outgoing(self, now):
+        """Envelope for one actual transmission; call only when it is sent."""
+        self.prune(now)
+        candidates = [e for e in self.cache.values() if e['hop_count'] < e['hop_limit']]
+        # Within the budget: vehicle/task first, then entries not yet forwarded,
+        # then the freshest. Own state always goes first.
+        candidates.sort(key=lambda e: (e['payload_type'] != 'vehicle_state',
+                                       (e['origin_id'], e['boot_id'], e['seq']) in self._sent,
+                                       self.age(e, now)[0], e['hop_count'], e['origin_id']))
+        chosen = ([self.own] if self.own is not None else [])+candidates
+        chosen = chosen[:self.capacity]
+        self._sent = {(e['origin_id'], e['boot_id'], e['seq']) for e in chosen}
+        envelope = []
+        for entry in chosen:
+            wire = _copy(entry)
+            wire.update(sender_id=self.device_id, receive_stamp=None)
+            envelope.append(wire)
+        return envelope
+
+    def tokens(self, now):
+        """Decision-time view of the cache; never contains this device itself."""
+        self.prune(now)
+        rows = []
+        for entry in self.cache.values():
+            age, unknown = self.age(entry, now)
+            state = entry['state']
+            rows.append(dict(origin_id=entry['origin_id'], payload_type=entry['payload_type'],
+                             position=np.asarray(state['position'], float),
+                             velocity=None if state['velocity'] is None else np.asarray(state['velocity'], float),
+                             goal=None if state['goal'] is None else np.asarray(state['goal'], float),
+                             age=float(age), hop=int(entry['hop_count']), time_unknown=unknown,
+                             # Clock error turns into position uncertainty at bounded speed.
+                             sigma=float(entry['sigma'])+self.speed_bound*self.clock_bound))
+        rows.sort(key=lambda row: (row['payload_type'] != 'vehicle_state', row['age'], row['hop'],
+                                   row['origin_id']))
+        return rows
