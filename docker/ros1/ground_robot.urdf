<?xml version="1.0"?>
<robot name="ground_0">
  <link name="ground_0/base_link">
    <inertial><mass value="10"/><inertia ixx="0.25" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.5"/></inertial>
    <visual><geometry><box size="0.6 0.4 0.2"/></geometry></visual>
    <collision><geometry><box size="0.6 0.4 0.2"/></geometry></collision>
  </link>
  <link name="left_wheel">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.06"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.06"/></geometry></collision>
  </link>
  <link name="right_wheel">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.06"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.06"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="ground_0/base_link"/><child link="left_wheel"/><origin xyz="0 0.23 0"/><axis xyz="0 1 0"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="ground_0/base_link"/><child link="right_wheel"/><origin xyz="0 -0.23 0"/><axis xyz="0 1 0"/></joint>
  <link name="caster">
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><sphere radius="0.05"/></geometry></visual><collision><geometry><sphere radius="0.05"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="ground_0/base_link"/><child link="caster"/><origin xyz="-0.24 0 -0.1"/></joint>
  <gazebo reference="caster"><mu1>0</mu1><mu2>0</mu2></gazebo>
  <gazebo reference="ground_0/base_link">
    <material>Gazebo/Red</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0.2 0 0 0</pose><update_rate>10</update_rate>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical></scan><range><min>0.3</min><max>20</max><resolution>0.02</resolution></range></ray>
      <plugin name="ground_lidar" filename="libgazebo_ros_velodyne_laser.so"><robotNamespace>/ground_0</robotNamespace><topicName>velodyne_points</topicName><frameName>ground_0/lidar_link</frameName><min_range>0.3</min_range><max_range>20</max_range></plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <robotNamespace>/ground_0</robotNamespace><legacyMode>false</legacyMode><updateRate>30</updateRate>
      <leftJoint>left_wheel_joint</leftJoint><rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.46</wheelSeparation><wheelDiameter>0.3</wheelDiameter><wheelTorque>20</wheelTorque>
      <commandTopic>cmd_vel</commandTopic><odometryTopic>odom</odometryTopic>
      <odometryFrame>ground_0/odom</odometryFrame><robotBaseFrame>ground_0/base_link</robotBaseFrame>
      <odometrySource>world</odometrySource><publishOdomTF>true</publishOdomTF><publishWheelTF>false</publishWheelTF>
    </plugin>
  </gazebo>
</robot>
